    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "homepage": ".",
  "description": "pickle-board - Pickleball doubles scoreboard (Android app via Capacitor)",
  "devDependencies": {
    "@capacitor/cli": "^8.6.3"
